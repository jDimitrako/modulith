{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=modulith_db;Username=admin;Password=admin",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "your-256-bit-secret",
    "Issuer": "modulith-api",
    "Audience": "modulith-clients",
    "ExpiryInMinutes": 60
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 10,
    "QueueLimit": 2
  },
  "OpenTelemetry": {
    "CollectorUrl": "http://localhost:4317"
  },
  "Modules": {
    "NewModule": {
      "Name": "NewModule",
      "BasePath": "/api/new-module",
      "Enabled": true,
      "Settings": {
        "FeatureFlag1": "true",
        "FeatureFlag2": "false"
      }
    },
    "DddModule": {
      "Name": "DddModule",
      "BasePath": "/api/ddd-module",
      "Enabled": true,
      "Settings": {
        "FeatureFlag1": "true"
      }
    }
  }
} 